# Copy to .env and fill in real values. Never commit .env.
# Used by docker-compose.yml for variable substitution.

# Gmail address used to send password-reset codes (Gmail App Password, not account password)
MAIL_USERNAME=

# Gmail App Password
MAIL_PASSWORD=

# Secret used to sign and verify JWT access/refresh tokens.
# Must be at least 32 bytes for HS256. Generate with: openssl rand -base64 48
JWT_SECRET=